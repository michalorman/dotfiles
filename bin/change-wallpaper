#!/bin/sh

set -eu

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/change-wallpaper"
wallpaper_file="$state_dir/wallpaper"

apply_wallpaper() {
  selected=$1

  if [ ! -r "$selected" ]; then
    printf 'Wallpaper is not readable: %s\n' "$selected" >&2
    exit 1
  fi
  if ! awww query >/dev/null 2>&1; then
    printf 'change-wallpaper: awww-daemon is not running (start it or relog).\n' >&2
    exit 1
  fi

  if [ "${2:-}" = restore ]; then
    awww img "$selected" --transition-type none
  else
    pos=$(hyprctl cursorpos 2>/dev/null || true)
    pos=$(printf '%s' "$pos" | tr -d ' ')
    case $pos in
      '' | *[!0-9,-]*)
        awww img "$selected" --transition-type grow --transition-pos center \
          --transition-duration 1 --transition-fps 60
        ;;
      *)
        awww img "$selected" --transition-type grow --transition-pos "$pos" \
          --transition-duration 1 --transition-fps 60
        ;;
    esac
  fi

  mkdir -p "$state_dir"
  printf '%s\n' "$selected" > "$wallpaper_file"
}

if ! command -v awww >/dev/null 2>&1; then
  printf 'change-wallpaper: awww is not installed.\n' >&2
  exit 1
fi

case ${1:-} in
  --restore)
    [ $# -eq 1 ] || exit 2
    [ -r "$wallpaper_file" ] || exit 0
    IFS= read -r selected < "$wallpaper_file" || true
    [ -n "$selected" ] || exit 0
    # awww-daemon starts in the same autostart batch; wait for its socket.
    tries=0
    until awww query >/dev/null 2>&1; do
      tries=$((tries + 1))
      if [ "$tries" -ge 20 ]; then
        printf 'change-wallpaper: awww-daemon not ready.\n' >&2
        exit 1
      fi
      sleep 0.1
    done
    apply_wallpaper "$selected" restore
    ;;
  --set)
    [ $# -eq 2 ] || exit 2
    apply_wallpaper "$2"
    ;;
  *)
    printf 'Usage: %s [--restore | --set IMAGE]\n' "$0" >&2
    exit 2
    ;;
esac
