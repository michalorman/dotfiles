#!/bin/sh

NOTES_DIR="$HOME/Notes"

notes="$(eza -s modified -r -1 "$NOTES_DIR")"

selected="$(printf "%s\n" "New note" "$notes" | bemenu-menu)"

if [ -z "$selected" ]; then
  exit 0
fi

if [ "$selected" = "New note" ]; then
  new_note=$(bemenu-menu --prompt "Enter new note name:" --list 1 down --width-factor 0.2 </dev/null)
  if [ -n "$new_note" ]; then
    case "$new_note" in
      *.*) ;;
      *) new_note="$new_note.md" ;;
    esac

    note_path="$NOTES_DIR/$new_note"

    touch "$note_path"
    $TERMINAL -e nvim "$note_path"
  fi
else
  $TERMINAL -e nvim "$NOTES_DIR/$selected"
fi
