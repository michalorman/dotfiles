#!/bin/sh

CAPTURES_PATH="$HOME/Pictures/Screenshots"

[ ! -d "$CAPTURES_PATH" ] && mkdir -p "$CAPTURES_PATH"

now="󰇄  Desktop"
win="  Window"
area="󰒉  Selection"

options="$now\n$win\n$area"

chosen="$(printf "%s\n" "$now" "$win" "$area" | dmenu -c -l 10 -i -bw 3 -F -h 35)"

case "$chosen" in
  "$now")
    flameshot full --path "$HOME/Pictures/Screenshots"
    ;;
  "$win")
    takeshot win
    ;;
  "$area")
    flameshot gui
    ;;
esac
