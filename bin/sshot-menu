#!/bin/sh

set -eu

captures_path="$HOME/Pictures/Screenshots"

mkdir -p "$captures_path"

screenshot_path() {
  printf '%s/%s.png' "$captures_path" "$(date +%F_%H-%M-%S)"
}

notify_saved() {
  notify-send "Screenshot saved to $1"
}

edit_saved() {
  notify_saved "$1"
  satty --filename "$1" --output-filename "$1" >/dev/null 2>&1 &
}

visible_window_region() {
  clients=$(hyprctl -j clients) || return 1
  monitors=$(hyprctl -j monitors) || return 1
  windows=$(printf '%s\n%s\n' "$clients" "$monitors" | jq -rs '
    .[1] as $monitors
    | ($monitors | map(.activeWorkspace.id)) as $workspaces
    | .[0][]
    | select(.mapped != false)
    | select(.workspace.id as $id | $workspaces | index($id))
    | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1]) \(((.class // "window") + ": " + (.title // "")) | gsub("[\r\n]"; " "))"
  ') || return 1
  [ -n "$windows" ] || return 1
  printf '%s\n' "$windows" | slurp -r
}

now="󰇄  Desktop"
win="  Window"
area="󰒉  Selection"

chosen="$(printf "%s\n" "$now" "$win" "$area" | bemenu-menu)"

case "$chosen" in
  "$now")
    path="$(screenshot_path)"
    sleep 0.5
    grim "$path" && edit_saved "$path"
    ;;
  "$win")
    region=$(visible_window_region) || exit 0
    path="$(screenshot_path)"
    grim -g "$region" "$path" && edit_saved "$path"
    ;;
  "$area")
    region=$(slurp) || exit 0
    path="$(screenshot_path)"
    grim -g "$region" "$path" && edit_saved "$path"
    ;;
esac
