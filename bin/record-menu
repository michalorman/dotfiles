#!/bin/sh

RECORDINGS_PATH="$HOME/Videos/Recordings"
STATE_PATH="${XDG_RUNTIME_DIR:-/tmp}/record-menu-$(id -u)"
PID_PATH="$STATE_PATH/gpu-screen-recorder.pid"
LOG_PATH="$STATE_PATH/gpu-screen-recorder.log"

menu() {
  dmenu -c -l 10 -i -bw 3 -F -h 35
}

notify() {
  notify-send "$1"
}

clear_stale_pid() {
  rm -f "$PID_PATH"
}

is_recording() {
  [ -r "$PID_PATH" ] || return 1
  IFS= read -r pid < "$PID_PATH" || {
    clear_stale_pid
    return 1
  }
  case "$pid" in
    ''|0|*[!0-9]*)
      clear_stale_pid
      return 1
      ;;
  esac
  case "$(ps -p "$pid" -o args= 2>/dev/null)" in
    *gpu-screen-recorder*) return 0 ;;
    *)
      clear_stale_pid
      return 1
      ;;
  esac
}

recording_path() {
  printf '%s/Recording_%s.mp4' "$RECORDINGS_PATH" "$(date +%F_%H-%M-%S)"
}

stop_recording() {
  if ! is_recording; then
    notify "No recording is running"
    return
  fi
  IFS= read -r pid < "$PID_PATH"
  kill -INT "$pid"
  notify "Finishing recording..."
}

start_recording() {
  source="$1"
  audio="$2"
  region="$3"
  mkdir -p "$RECORDINGS_PATH" "$STATE_PATH" || return 1

  if is_recording; then
    notify "A recording is already running"
    return 1
  fi

  path="$(recording_path)"
  set -- gpu-screen-recorder -w "$source" -f 50 -k h264 -c mp4 -fm cfr
  [ -n "$region" ] && set -- "$@" -region "$region"
  [ -n "$audio" ] && set -- "$@" -a "$audio"
  sleep 0.5
  "$@" -o "$path" >"$LOG_PATH" 2>&1 &
  printf '%s\n' "$!" > "$PID_PATH"

  sleep 0.2
  if is_recording; then
    notify "Recording started: $path"
  else
    notify "Unable to start recording (see $LOG_PATH)"
    return 1
  fi
}

choose_audio() {
  no_audio="󰖁  No audio"
  desktop_audio="󰕾  Desktop audio"
  desktop_microphone="󰍬  Desktop + microphone"
  desktop_microphone_webcam="󰖠  Desktop + microphone + webcam"

  audio_chosen="$(printf '%s\n' "$no_audio" "$desktop_audio" "$desktop_microphone" "$desktop_microphone_webcam" | menu)"
  case "$audio_chosen" in
    "$no_audio") audio="" ;;
    "$desktop_audio") audio="default_output" ;;
    "$desktop_microphone") audio="default_output|default_input" ;;
    "$desktop_microphone_webcam")
      audio="default_output|default_input"
      webcam=1
      ;;
    *) return 1 ;;
  esac
  return 0
}

choose_recording() {
  screen="󰍹  Monitor"
  area="󰩭  Area"
  window="  Window"
  stop="󰑊  Stop recording"
  region=""

  chosen="$(printf '%s\n' "$screen" "$area" "$window" "$stop" | menu)"
  case "$chosen" in
    "$stop")
      stop_recording
      return 0
      ;;
    "$screen"|"$area"|"$window")
      ;;
    *) return 1 ;;
  esac

  webcam=0
  audio=""
  choose_audio || return 1

  case "$chosen" in
    "$screen")
      source="$(slurp -o -r -f '%o')" || return 1
      ;;
    "$area")
      region="$(slurp -f '%wx%h+%x+%y')" || return 1
      source="region"
      ;;
    "$window")
      source="portal"
      ;;
  esac

  if [ "$webcam" -eq 1 ]; then
    source="$source|/dev/video0;camera_width=1280;camera_height=720;camera_fps=30;pixfmt=mjpeg;width=25%;height=25%;halign=end;valign=end"
  fi
  start_recording "$source" "$audio" "$region"
}

follow_status() {
  last=""
  while :; do
    if is_recording; then
      status="recording"
    else
      status="stopped"
    fi
    if [ "$status" != "$last" ]; then
      printf '%s\n' "$status"
      last="$status"
    fi
    sleep 0.2
  done
}

case "${1:-}" in
  status)
    follow_status
    ;;
  stop)
    stop_recording
    ;;
  "")
    choose_recording
    ;;
  *)
    printf 'Usage: %s {status|stop}\n' "$0" >&2
    exit 2
    ;;
esac
