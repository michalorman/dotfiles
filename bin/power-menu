#!/bin/sh

lock="󰌾  Lock"
sleep="󰒲  Sleep"
hibernate="󰤄  Hibernate"
restart="󰜉  Restart"
shutdown="󰐥  Shutdown"
logout="󰍃  Logout"

chosen="$(printf "%s\n" "$lock" "$sleep" "$hibernate" "$restart" "$shutdown" "$logout" | dmenu -c -l 10 -i -bw 3 -F -h 35)"

case "$chosen" in
  "$lock")
    lockscreen
    ;;
  "$sleep")
    systemctl suspend
    ;;
  "$hibernate")
    systemctl hibernate
    ;;
  "$restart")
    systemctl reboot
    ;;
  "$shutdown")
    systemctl poweroff
    ;;
  "$logout")
    pkill -KILL -x dwm
    ;;
esac

