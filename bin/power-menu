#!/bin/sh

lock="󰌾  Lock"
sleep="󰒲  Sleep"
hibernate="󰤄  Hibernate"
restart="󰜉  Restart"
shutdown="󰐥  Shutdown"
logout="󰍃  Logout"

chosen="$(printf "%s\n" "$lock" "$sleep" "$hibernate" "$restart" "$shutdown" "$logout" | dmenu -c -l 10 -i -bw 3 -F -h 35)"

case "$chosen" in
  "$lock")
    swaylock --daemonize --color 000000
    ;;
  "$sleep")
    swaylock --daemonize --color 000000 && systemctl suspend
    ;;
  "$hibernate")
    swaylock --daemonize --color 000000 && systemctl hibernate
    ;;
  "$restart")
    systemctl reboot
    ;;
  "$shutdown")
    systemctl poweroff
    ;;
  "$logout")
    hyprctl dispatch 'hl.dsp.exit()'
    ;;
esac
