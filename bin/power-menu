#!/bin/sh

lock_screen() {
  lock-screen
}

lock="󰌾  Lock"
sleep="󰒲  Sleep"
hibernate="󰤄  Hibernate"
restart="󰜉  Restart"
shutdown="󰐥  Shutdown"
logout="󰍃  Logout"

chosen="$(printf "%s\n" "$lock" "$sleep" "$hibernate" "$restart" "$shutdown" "$logout" | bemenu-menu)"

case "$chosen" in
  "$lock")
    lock_screen
    ;;
  "$sleep")
    systemctl suspend
    ;;
  "$hibernate")
    systemctl hibernate
    ;;
  "$restart")
    systemctl reboot
    ;;
  "$shutdown")
    systemctl poweroff
    ;;
  "$logout")
    hyprctl dispatch 'hl.dsp.exit()'
    ;;
esac
