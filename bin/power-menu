#!/bin/sh

wallpaper_file="${XDG_STATE_HOME:-$HOME/.local/state}/change-wallpaper/wallpaper"

lock_screen() {
  if [ -r "$wallpaper_file" ]; then
    IFS= read -r wallpaper < "$wallpaper_file" || wallpaper=
    if [ -n "$wallpaper" ] && [ -r "$wallpaper" ]; then
      swaylock --daemonize --image "$wallpaper" --scaling stretch
      return
    fi
  fi

  swaylock --daemonize --color 000000
}

lock="󰌾  Lock"
sleep="󰒲  Sleep"
hibernate="󰤄  Hibernate"
restart="󰜉  Restart"
shutdown="󰐥  Shutdown"
logout="󰍃  Logout"

chosen="$(printf "%s\n" "$lock" "$sleep" "$hibernate" "$restart" "$shutdown" "$logout" | dmenu -c -l 10 -i -bw 3 -F -h 35)"

case "$chosen" in
  "$lock")
    lock_screen
    ;;
  "$sleep")
    lock_screen && systemctl suspend
    ;;
  "$hibernate")
    lock_screen && systemctl hibernate
    ;;
  "$restart")
    systemctl reboot
    ;;
  "$shutdown")
    systemctl poweroff
    ;;
  "$logout")
    hyprctl dispatch 'hl.dsp.exit()'
    ;;
esac
