# Tokyo Night notifications matching the previous Dunst layout.
font=JetBrainsMono Nerd Font 10
width=325
height=300
anchor=top-right
outer-margin=50,10,0,0
margin=0,0,10,0
padding=20,25
background-color=#1a1b26
text-color=#7aa2f7
border-size=1
border-color=#7da6ff
border-radius=0
progress-color=over #7aa2f7
icons=1
max-icon-size=32
icon-location=left
markup=1
actions=1
history=1
max-history=20
sort=-priority
group-by=app-name,summary,body
max-visible=-1
format=<b>%s</b>\n%b
text-alignment=left
default-timeout=10000
ignore-timeout=1
layer=overlay
on-button-left=invoke-default-action
on-button-middle=invoke-default-action
on-button-right=dismiss-all

[urgency=critical]
text-color=#ff7a93
border-color=#ff7a93
progress-color=over #ff7a93
default-timeout=0
