#!/bin/sh

userresources=$HOME/.config/X11/Xresources
usermodmap=$HOME/.config/X11/Xmodmap
sysresources=/etc/X11/xinit/.Xresources
sysmodmap=/etc/X11/xinit/.Xmodmap

# merge in defaults and keymaps

if [ -f $sysresources ]; then
	xrdb -merge $sysresources
fi

if [ -f $sysmodmap ]; then
	xmodmap $sysmodmap
fi

if [ -f "$userresources" ]; then
	xrdb -merge "$userresources"
fi

if [ -f "$usermodmap" ]; then
	xmodmap "$usermodmap"
fi

# HiDPI scaling for BenQ RD280U (3840x2560, 164 PPI).
export XCURSOR_SIZE=32

xrdb -merge <<'EOF'
Xft.dpi: 164
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: rgb
Xcursor.size: 32
EOF

# start some nice programs

if [ -d /etc/X11/xinit/xinitrc.d ] ; then
	for f in /etc/X11/xinit/xinitrc.d/?*.sh ; do
		[ -x "$f" ] && . "$f"
	done
	unset f
fi

# Start removable disk automounter
udiskie &

# Launch notification daemon
dunst -config "$HOME/.config/dunst/dunstrc" &

# Resolution
#xrandr -s 2560x1080 &

# Compositor
picom --config "$HOME"/.config/picom/picom.conf &

# [ -x "$(command -v playerctld)" ] && playerctld daemon

# Restore wallpaper
if [ -f ~/.fehbg ]; then
	~/.fehbg &
fi

# Start dwmblocks
#dwmblocks &

# Set keyboard layout and remap capslock to ctrl
setxkbmap -layout pl -option ctrl:nocaps &

# Start GNOME Keyring if available
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
  eval "$(gnome-keyring-daemon --start --components=pkcs11,secrets,ssh,gpg)"
  export SSH_AUTH_SOCK
fi

# Start wm
exec opendwm
